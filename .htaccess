Options -Indexes

# Prevent direct access to includes
<FilesMatch "^(config|auth|header|footer|.*-sidebar|dashboard-footer)\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# PHP settings
php_flag session.cookie_httponly On
php_flag session.use_only_cookies On

# Security headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options SAMEORIGIN
    Header always set X-XSS-Protection "1; mode=block"
    Header always set X-Content-Type-Options nosniff
</IfModule>

# Rewrite rules
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /reuchne-clinic/
    RewriteRule ^favicon\.ico$ /assets/images/placeholders/rb-logo-white-transparent.png [L]
</IfModule>
